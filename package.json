{
  "name": "chickapi",
  "version": "1.0.0",
  "description": "ChickAPI - A visual programming tool for designing and testing API workflows",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "start": "npm run build && electron .",
    "dev": "concurrently \"npm run build:watch\" \"wait-on dist/main.js && electron .\"",
    "dev:next": "next dev",
    "build:next": "next build",
    "build:production": "npm run lint && npm run test && next build",
    "start:next": "next start",
    "export:next": "next build && next export",
    "db:init": "node scripts/init-mongodb.js",
    "db:setup": "npm run db:init",
    "deploy": "vercel",
    "deploy:prod": "vercel --prod",
    "package": "electron-builder",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "analyze": "cross-env ANALYZE=true npm run build:next",
    "bundle-analyzer": "cross-env BUNDLE_ANALYZE=true npm run build:next",
    "clean": "rimraf .next dist build coverage",
    "docker:build": "docker build -f Dockerfile.production -t chickapi:latest .",
    "docker:run": "docker run -p 3000:3000 chickapi:latest",
    "deploy:staging": "npm run build:production && docker build -f Dockerfile.production -t chickapi:staging .",
    "deploy:production": "npm run test:ci && npm run build:production && docker build -f Dockerfile.production -t chickapi:production .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "precommit": "npm run lint && npm run type-check",
    "size": "npm run build:next && npx bundlesize",
    "perf": "npm run build:next && npx lighthouse http://localhost:3000 --view"
  },
  "keywords": [
    "api",
    "testing",
    "visual-programming",
    "electron",
    "workflow",
    "chickapi"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "@types/jsonpath": "^0.2.4",
    "@types/node": "^20.10.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "autoprefixer": "^10.4.21",
    "bundlesize": "^0.18.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.8.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "lighthouse": "^11.4.0",
    "postcss": "^8.5.6",
    "prisma": "^6.16.0",
    "rimraf": "^5.0.5",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vercel": "^47.1.4",
    "wait-on": "^7.2.0",
    "webpack-bundle-analyzer": "^4.10.1"
  },
  "dependencies": {
    "@babel/parser": "^7.28.4",
    "@babel/traverse": "^7.28.4",
    "@headlessui/react": "^2.2.7",
    "@heroicons/react": "^2.2.0",
    "@prisma/client": "^6.16.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/mongodb": "^4.0.6",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "axios": "^1.6.0",
    "cheerio": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "jsonpath": "^1.1.1",
    "lodash": "^4.17.21",
    "lucide-react": "^0.543.0",
    "mongodb": "^6.19.0",
    "next": "^15.5.2",
    "node-cron": "^4.2.1",
    "ogl": "^1.0.11",
    "puppeteer": "^24.20.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hot-toast": "^2.6.0",
    "reactflow": "^11.11.4",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^9.0.1"
  },
  "build": {
    "appId": "com.chickapi.flowdesigner",
    "productName": "ChickAPI",
    "directories": {
      "output": "build"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
